# ─────────────────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA coloque chaves secretas em variáveis com prefixo NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# URL pública do app (usada nos links de confirmação e recuperação de senha)
# Desenvolvimento: http://localhost:3000   | Produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Chave pública (anon / publishable). Pode ir ao navegador, pois o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Análise com IA (Fase 2). Somente servidor.
# Sem essa chave, o resto do app funciona e só o diagnóstico fica indisponível.
ANTHROPIC_API_KEY=

# Fase 4 (ainda não usada): pagamentos, somente no servidor
# MERCADOPAGO_ACCESS_TOKEN=
